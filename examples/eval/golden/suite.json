  "tasks": [
    {
      "id": "read-func-behavior",
      "description": "Explain the behaviour of add() for negative inputs.",
      "category": "read",
      "tags": ["read", "function-behavior"],
      "fixture": "fixtures/read-func-behavior",
      "message": "Read calc.py and explain what add() returns when either input is negative. Do not modify any file.",
      "oracle": {
        "file_checks": [
          {"type": "file_contains", "path": "calc.py", "value": "def add"},
          {"type": "file_contains", "path": "calc.py", "value": "return a + b"}
        ]
      },
      "integrity": {"read_only": true},
      "scenario": {"type": "single"}
    },
    {
      "id": "read-config-priority",
      "description": "Explain the configuration precedence order.",
      "category": "read",
      "tags": ["read", "config-priority"],
      "fixture": "fixtures/read-config-priority",
      "message": "Read loader.py and list the precedence order between environment variables, the config file, and defaults. Do not modify any file.",
      "oracle": {
        "file_checks": [
          {"type": "file_contains", "path": "loader.py", "value": "os.environ"},
          {"type": "file_contains", "path": "loader.py", "value": "DEFAULTS"}
        ]
      },
      "integrity": {"read_only": true},
      "scenario": {"type": "single"}
    },
    {
      "id": "read-call-chain",
      "description": "Trace the cross-file call chain from pipeline to stages.",
      "category": "read",
      "tags": ["read", "call-chain"],
      "fixture": "fixtures/read-call-chain",
      "message": "Trace how run() in pipeline.py reaches run_stage() in stages.py and report the call chain. Do not modify any file.",
      "oracle": {
        "file_checks": [
          {"type": "file_exists", "path": "pipeline.py"},
          {"type": "file_exists", "path": "stages.py"},
          {"type": "file_contains", "path": "pipeline.py", "value": "from stages import"}
        ]
      },
      "integrity": {"read_only": true},
      "scenario": {"type": "single"}
    },
    {
      "id": "read-test-expectation",
      "description": "Report the expected behaviour encoded in the tests.",
      "category": "read",
      "tags": ["read", "test-expectation"],
      "fixture": "fixtures/read-test-expectation",
      "message": "Read tests/test_truncate.py and state the exact expected output for truncate(\"abcdef\", 3). Do not modify any file.",
      "oracle": {
        "file_checks": [
          {
            "type": "file_contains",
            "path": "tests/test_truncate.py",
            "value": "truncate(\"abcdef\", 3) == \"abc\""
          }
        ]
      },
      "integrity": {"read_only": true},
      "scenario": {"type": "single"}
    },
    {
      "id": "read-related-files",
