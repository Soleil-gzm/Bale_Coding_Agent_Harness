      "tags": ["bugfix", "single-file", "arithmetic"],
      "fixture": "fixtures/edit-add-negative",
      "message": "add() in calc.py returns the wrong value when either input is negative. Fix it without changing the function signature.",
      "oracle": {
        "f2p": [["python", "-m", "pytest", "-q", "tests/test_add_f2p.py"]],
        "p2p": [["python", "-m", "pytest", "-q", "tests/test_add_p2p.py"]],
        "hidden": [["python", "-m", "pytest", "-q", "hidden/test_hidden.py"]],
        "file_checks": []
      },
      "integrity": {
        "forbidden_changes": ["tests/**", "verifier/**"],
        "max_files_changed": 1,
        "max_lines_changed": 10
      },
      "scenario": {"type": "single"},
      "gold_patch": "patches/edit-add-negative.patch"
    },
