      "tags": ["read", "related-files"],
      "fixture": "fixtures/read-related-files",
      "message": "Find every file involved in calculating a discounted total and cite them. Do not modify any file.",
      "oracle": {
        "file_checks": [
          {"type": "file_exists", "path": "pricing.py"},
          {"type": "file_exists", "path": "discount.py"},
