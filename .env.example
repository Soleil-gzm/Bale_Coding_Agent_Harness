BALE_PROVIDER=fake

# OpenAI-compatible provider (openai, DeepSeek, local Ollama).
# BALE_OPENAI_API_KEY is required for remote endpoints and optional for
# loopback hosts such as http://127.0.0.1:11434/v1.
# BALE_OPENAI_BASE_URL=https://api.deepseek.com/v1
# BALE_OPENAI_MODEL=deepseek-chat
# BALE_OPENAI_API_KEY=

# BALE_CONTEXT_WINDOW=128000
# BALE_TRACE_PATH=.bale/trace.jsonl
# BALE_INPUT_COST_PER_1K=
# BALE_OUTPUT_COST_PER_1K=
