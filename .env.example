BALE_PROVIDER=fake

# OpenAI-compatible provider (openai, DeepSeek, local Ollama).
# BALE_OPENAI_API_KEY is required for remote endpoints and optional for
# loopback hosts such as http://127.0.0.1:11434/v1.
# BALE_OPENAI_BASE_URL=https://api.deepseek.com/v1
# BALE_OPENAI_MODEL=deepseek-chat
# BALE_OPENAI_API_KEY=

# BALE_CONTEXT_WINDOW=128000
# BALE_TRACE_PATH=.bale/trace.jsonl
# BALE_INPUT_COST_PER_1K=
# BALE_OUTPUT_COST_PER_1K=

# HTTP: bearer auth for /v1 routes and stdio MCP servers loaded at startup.
# BALE_HTTP_API_KEY=
# Multiple keys with a principal and scope; JSON object keyed by bearer token.
# BALE_HTTP_API_KEYS={"alice-key": {"principal": "alice", "scope": "write"}}
# BALE_MCP_CONFIG=examples/mcp/servers.json

# HTTP production: persistent sessions, rate limiting, approvals, audit.
# BALE_HTTP_SESSION_DB=.bale/sessions.db
# BALE_HTTP_RATE_LIMIT_PER_MINUTE=0
# BALE_HTTP_APPROVALS=false
# BALE_HTTP_APPROVAL_TIMEOUT_SECONDS=120
# BALE_HTTP_AUDIT_LOG=.bale/audit.jsonl

# Automatic BM25 retrieval injected into each turn.
# BALE_RETRIEVAL_ENABLED=true
# BALE_RETRIEVAL_TOP_K=5

# Execution sandbox: local (default) or docker (one container per command).
# BALE_SANDBOX_BACKEND=local
# BALE_SANDBOX_IMAGE=python:3.11-slim
# BALE_SANDBOX_NETWORK=false
# BALE_SANDBOX_MEMORY=1g
# BALE_SANDBOX_CPUS=1.0
# BALE_SANDBOX_PIDS_LIMIT=256
# BALE_SANDBOX_USER=10001:10001
